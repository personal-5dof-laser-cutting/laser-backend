{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debugger Svg to gcode",
            "type": "debugpy",
            "request": "launch",
            "module": "util.svg_to_gcode",
            "args": [
                "7.75", // material thickness
                "illustrator", // scaling
                "3", // cut speed in mm/s
                "6.0", // material constant
                "/home/edi/Downloads/hidden_joints_small_top.svg",
                "top2.gcode"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debugger Svg to gcode Ocarina",
            "type": "debugpy",
            "request": "launch",
            "module": "util.svg_to_gcode",
            "args": [
                "5", // material thickness
                "illustrator", // scaling
                "7", // cut speed in mm/s
                "7.0", // material constant
                "/home/edi/Downloads/ocarina_no_fillings_test_newly_scaled.svg",
                "ocarina.gcode"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debugger SVG to GCODE The GUY",
            "type": "debugpy",
            "request": "launch",
            "module": "util.svg_to_gcode",
            "args": [
                "6", // material thickness
                "72", // scaling
                "7", // cut speed in mm/s
                "3.2", // material constant
                "5",
                "/home/edi/Downloads/the-guy-test.svg",
                "the-real-guy.gcode"
            ],
            "console": "integratedTerminal"
        }
    ]
}